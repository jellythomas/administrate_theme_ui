<% content_for(:title) { display_resource_name(page.resource_name) } %>
<% atu_crumbs(AdministrateThemeUi.config.app_name, display_resource_name(page.resource_name)) %>

<%= atu_page_header(content_for(:title), subtitle: (resources.respond_to?(:total_count) ? "#{number_with_delimiter(resources.total_count, delimiter: AdministrateThemeUi.config.delimiter)} records" : nil)) do %>
  <%= content_for(:header_middle) %>
  <%= render "index_actions", page: page, resources: resources %>
  <% if accessible_action?(new_resource, :new) %>
    <%= atu_button(t("administrate.actions.new_resource", name: display_resource_name(page.resource_name, singular: true).downcase),
                   [:new, namespace, page.resource_path.to_sym], icon: "plus") %>
  <% end %>
  <%= content_for(:header_last) %>
<% end %>

<% if show_search_bar %>
  <div class="atu-toolbar">
    <%= render("search", search_term: search_term, resource_name: display_resource_name(page.resource_name)) %>
    <% if filters.any? %>
      <%# Same markup/behaviour as Administrate's index header: a help popover listing the filters. %>
      <div class="atu-filter-help" data-controller="tooltip">
        <button type="button" data-tooltip-target="tooltip" popovertarget="search-tooltip" class="atu-iconbtn button--tooltip search__tooltip" aria-label="Search filters"><%= atu_icon("filter", size: 15) %></button>
        <div data-tooltip-target="popover" popover id="search-tooltip" role="tooltip" class="atu-popover search__tooltip-popover search__tooltip-popover-positioning">
          <p><strong>Use filters to refine your search</strong></p>
          <ul>
            <% filters.keys.each do |filter_key| %>
              <li><code><%= filter_key %>:<span class="search__tooltip-popover-value">&lt;value&gt;</span></code></li>
            <% end %>
          </ul>
        </div>
      </div>
    <% end %>
    <%= content_for(:atu_toolbar_end) %>
  </div>
<% end %>
