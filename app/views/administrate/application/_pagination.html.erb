<%# Administrate's pagination (Kaminari `paginate`, same param_name), with a range summary. %>
<% if resources.respond_to?(:total_pages) && resources.total_pages > 1 %>
  <% d = AdministrateThemeUi.config.delimiter %>
  <% from = resources.offset_value + 1 %>
  <% to = [resources.offset_value + resources.limit_value, resources.total_count].min %>
  <div class="atu-pager">
    <span class="atu-pager__range"><%= number_with_delimiter(from, delimiter: d) %>–<%= number_with_delimiter(to, delimiter: d) %> of <%= number_with_delimiter(resources.total_count, delimiter: d) %></span>
    <%= paginate resources, param_name: local_assigns.fetch(:param_name, "_page"), theme: "administrate_theme_ui" %>
  </div>
<% end %>
