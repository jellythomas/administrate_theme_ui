<%= render("index_header", resources: resources, search_term: search_term, page: page, show_search_bar: show_search_bar, filters: filters) %>

<%= content_for(:before_main) %>

<% if content_for?(:main) %>
  <%= content_for(:main) %>
<% else %>
  <section class="atu-card atu-card--flush atu-card--table">
    <% if resources.any? %>
      <%= render("collection", collection_presenter: page, collection_field_name: resource_name, page: page, resources: resources, table_title: "page-title") %>
      <%= render("pagination", resources: resources) %>
    <% else %>
      <%= atu_empty_state(title: search_term.present? ? "No results for “#{search_term}”" : "No #{display_resource_name(page.resource_name).downcase} yet",
                          description: search_term.present? ? "Try a different keyword or clear the filters." : nil) do %>
        <% if search_term.present? %><%= atu_button("Clear search", clear_search_params, variant: :secondary) %><% end %>
      <% end %>
    <% end %>
  </section>
<% end %>

<%= content_for(:after_main) %>
