<% content_for(:title) { t("administrate.actions.edit_resource", name: page.page_title) } %>
<% atu_crumbs(AdministrateThemeUi.config.app_name, [display_resource_name(page.resource_name), (polymorphic_path([namespace, page.resource.class]) rescue nil)], [page.page_title, (polymorphic_path([namespace, page.resource]) rescue nil)], "Edit") %>

<%= atu_page_header(content_for(:title)) do %>
  <%= content_for(:header_middle) %>
  <%= (atu_button(t("administrate.actions.show_resource", name: page.page_title), [namespace, page.resource], variant: :secondary, icon: "eye") if accessible_action?(page.resource, :show)) %>
  <%= content_for(:header_last) %>
<% end %>

<%= content_for(:before_main) %>

<% if content_for?(:main) %>
  <%= content_for(:main) %>
<% else %>
  <%= render "form", page: page %>
<% end %>

<%= content_for(:after_main) %>
