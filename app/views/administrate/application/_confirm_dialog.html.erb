<%# Styled presentation of Turbo's confirm (data-turbo-confirm), registered via Turbo.setConfirmMethod. %>
<dialog class="atu-modal atu-modal--sm" id="atu-confirm" role="alertdialog" aria-labelledby="atu-confirm-message" data-atu-static>
  <div class="atu-modal__panel">
    <header class="atu-modal__header">
      <div class="atu-confirm__icon"><%= atu_icon("alert", size: 18) %></div>
      <h1 class="atu-modal__title" id="atu-confirm-message" data-atu-confirm-message></h1>
    </header>
    <footer class="atu-modal__footer">
      <button type="button" class="atu-btn atu-btn--secondary" value="cancel" data-atu-confirm-cancel>Cancel</button>
      <button type="button" class="atu-btn atu-btn--danger" value="confirm" data-atu-confirm-accept>OK</button>
    </footer>
  </div>
</dialog>
