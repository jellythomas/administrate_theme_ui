<%# Same behaviour as Administrate: every flash rendered inline at the top, persistent. %>
<% if flash.any? %>
  <div class="atu-flashes flashes">
    <% flash.each do |key, value| -%>
      <% next unless value.respond_to?(:html_safe) %>
      <% tone = { "notice" => :success, "success" => :success, "alert" => :danger, "error" => :danger, "warning" => :warning }.fetch(key.to_s, :info) %>
      <div class="atu-alert atu-alert--<%= tone %> flash flash-<%= key %>" role="<%= tone == :danger ? "alert" : "status" %>">
        <%= atu_icon({ success: "check-circle", danger: "x-circle", warning: "alert" }.fetch(tone, "info"), size: 18, class: "atu-alert__icon") %>
        <div class="atu-alert__content"><%= value.html_safe %></div>
      </div>
    <% end -%>
  </div>
<% end %>
